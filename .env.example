# ── Supabase (client-side) ─────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Supabase Service Role (Edge Functions only — NEVER expose to the browser) ──
# Found in: Supabase Dashboard → Project Settings → API → service_role key
# This is set as a Supabase secret, not a local .env variable.
# See Edge Functions deployment section in README.md.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Supabase JWT Secret (Edge Functions only — NEVER expose to the browser) ───
# Found in: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
# Used to verify incoming user JWTs in Edge Functions.
# Set via: supabase secrets set SUPABASE_JWT_SECRET=your_jwt_secret
# This is a Supabase-managed secret, not a local .env variable.
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ── CORS Allowed Origin (Edge Functions only) ──────────────────────────────────
# Set to your production domain to restrict CORS in deployed Edge Functions.
# Defaults to "*" (open) when not set — safe for local development only.
# Set via: supabase secrets set ALLOWED_ORIGIN=https://yatranepal.com
# ALLOWED_ORIGIN=https://yatranepal.com

# ── Email transport (Edge Functions only) ──────────────────────────────────────
# "resend" (default) or "mailtrap". "mailtrap" is refused at boot when
# ENVIRONMENT=production, so a sandbox transport can never silently swallow
# real production email.
# Set via: supabase secrets set EMAIL_MODE=resend
# EMAIL_MODE=resend

# Required in production (no fallback address is used there).
# Set via: supabase secrets set FROM_EMAIL=noreply@intonepal.com
# FROM_EMAIL=noreply@intonepal.com

# Recipient for contact-form submissions. Defaults to support@intonepal.com
# when not set.
# Set via: supabase secrets set SUPPORT_INBOX=support@intonepal.com
# SUPPORT_INBOX=support@intonepal.com

# ── Sentry (frontend error tracking) ────────────────────────────────────────────
# DSN is public-safe (it identifies where to send events, not a secret) but is
# still gated behind this variable so local development never reports errors
# anywhere by default — leave it unset to run with Sentry fully inert.
# Found in: Sentry → Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=

# Tags every event with this environment (development/staging/production) and
# selects it in src/main.tsx. Defaults to "development" when unset.
VITE_APP_ENV=development

# ── Cloudflare Turnstile (contact form bot protection) ─────────────────────────
# Site key is public — safe to expose to the browser.
# Found in: Cloudflare Dashboard → Turnstile → your widget
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Secret key is Edge-Functions-only — NEVER expose to the browser.
# Set via: supabase secrets set TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ── Notification dispatch worker (Edge Functions only) ─────────────────────────
# Shared secret the pg_cron job presents to dispatch-notifications. Generate
# a long random value and store it in both places below — it is never sent
# to the browser.
# Set via: supabase secrets set NOTIFICATIONS_CRON_SECRET=your_random_secret
# Also store the same value in Supabase Vault — see the one-time setup step
# documented at the top of supabase/functions/dispatch-notifications/index.ts.
# NOTIFICATIONS_CRON_SECRET=your_random_secret

# Inbox that receives the daily ops health alert (OPS_DAILY_HEALTH domain
# event, supabase/migrations/20260917000025_ops_daily_health_alert.sql) —
# only sent on a day something actually failed (a cron job, or a
# permanently-failed notification), never a daily "all clear" ping.
# Set via: supabase secrets set OPS_ALERT_EMAIL=ops@intonepal.com
# OPS_ALERT_EMAIL=ops@intonepal.com
